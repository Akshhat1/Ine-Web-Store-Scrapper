# Backend environment variables — copy to .env and fill in real values

# Server
PORT=3001

# Supabase (service role key — backend only, never expose to frontend)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# The target store
STORE_BASE_URL=https://demo.inelabteamdev.com

# Secret for cron and manual scrape endpoints
CRON_SECRET=change_this_to_a_long_random_string

# Frontend origin for CORS (e.g. https://your-app.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173

# Playwright (set to true only on machines that have Playwright + Chromium installed)
# On Render free tier this may require a custom Docker image (see README)
ENABLE_BROWSER=true

# Scraper tuning
SCRAPE_TIMEOUT_MS=30000
MAX_RETRIES=3
PRICE_JUMP_THRESHOLD=0.5
RUN_TIME_BUDGET_MS=600000

# Catalog cache TTL (how long to keep the 1000-product name cache, ms)
CATALOG_CACHE_TTL_MS=3600000
